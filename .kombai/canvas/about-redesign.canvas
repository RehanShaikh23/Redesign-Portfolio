      },
      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-geist { font-family: 'Geist', sans-serif; }\n  .font-jbmono { font-family: 'JetBrains Mono', monospace; }\n\n  /* ticket-stub notches (top-right & bottom-right, 14px) */\n  .notch-clip {\n    clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);\n  }\n\n  /* blueprint grid for ecosystem card */\n  .blueprint-grid {\n    background-image:\n      linear-gradient(rgba(59,130,246,0.055) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(59,130,246,0.055) 1px, transparent 1px);\n    background-size: 28px 28px;\n  }\n\n  /* fine halftone grid over photo */\n  .halftone {\n    background-image:\n      linear-gradient(rgba(4,13,31,0.35) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(4,13,31,0.35) 1px, transparent 1px);\n    background-size: 5px 5px;\n  }\n\n  /* animated dashed connectors (GSAP animates background-position) */\n  .flow-dash-h {\n    height: 2px;\n    background-image: repeating-linear-gradient(90deg, rgba(148,163,184,0.55) 0 7px, transparent 7px 14px);\n    background-size: 14px 2px;\n  }\n  .flow-dash-v {\n    width: 2px;\n    background-image: repeating-linear-gradient(180deg, rgba(148,163,184,0.55) 0 7px, transparent 7px 14px);\n    background-size: 2px 14px;\n  }\n\n  @keyframes caret-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }\n  .caret { animation: caret-blink 1s steps(1) infinite; }\n\n  /* hover mechanics for flow nodes (CSS only — these are NOT GSAP targets) */\n  .flow-node { transition: transform .3s cubic-bezier(.16,1,.3,1), border-color .3s, box-shadow .3s; }\n  .flow-node:hover { transform: translateY(-3px) scale(1.03); }\n  .flow-node-pink:hover { border-color: rgba(236,72,153,0.6); box-shadow: 0 0 24px rgba(236,72,153,0.18); }\n  .flow-node-blue:hover { border-color: rgba(59,130,246,0.8); box-shadow: 0 0 32px rgba(59,130,246,0.3); }\n  .flow-node-emerald:hover { border-color: rgba(16,185,129,0.6); box-shadow: 0 0 24px rgba(16,185,129,0.18); }\n</style>\n<div class=\"font-geist antialiased text-slate-300 min-h-screen\" data-kid=\"1\" data-name=\"page layout container\" style=\"background-color:#040D1F;\">\n    <section class=\"max-w-7xl mx-auto px-6 lg:px-12 py-20 lg:py-32\" data-kid=\"1-1\" data-name=\"about section\">\n        \n        <div class=\"mb-14\" data-kid=\"1-1-1\" data-name=\"section header\" id=\"about-header\">\n            <div class=\"flex items-end gap-4\" data-kid=\"1-1-1-1\" data-name=\"section header content row\">\n                <span class=\"font-jbmono text-2xl lg:text-3xl text-pink-500\" data-kid=\"1-1-1-1-1\" data-name=\"section index number text\">\n                    01.\n                </span>\n                <h2 class=\"text-3xl lg:text-4xl font-semibold text-slate-100 tracking-tight\" data-kid=\"1-1-1-1-2\" data-name=\"section title headline\">\n                    About Me\n                </h2>\n                \n                <svg aria-hidden=\"true\" class=\"hidden sm:block ml-4 mb-1\" data-kid=\"1-1-1-1-3\" data-name=\"circuit path SVG graphic\" fill=\"none\" height=\"52\" id=\"circuit-line\" viewbox=\"0 0 360 52\" width=\"360\">\n                    <path d=\"M0 10 H176 L208 40 H332\" id=\"circuit-path\" stroke=\"#EC4899\" stroke-dasharray=\"6 6\" stroke-opacity=\"0.45\" stroke-width=\"1.5\" data-kid=\"2\">\n                    </path>\n                    <circle cx=\"176\" cy=\"10\" fill=\"#EC4899\" fill-opacity=\"0.7\" r=\"2.5\" data-kid=\"3\">\n                    </circle>\n                    <circle cx=\"338\" cy=\"40\" fill=\"#EC4899\" id=\"circuit-dot\" r=\"3.5\" data-kid=\"4\">\n                    </circle>\n                </svg>\n            </div>\n            <p class=\"font-jbmono text-xs text-slate-500 mt-3 tracking-widest uppercase\" data-kid=\"1-1-1-2\" data-name=\"system profile revision text\">\n                // system profile — rev 2.0\n            </p>\n        </div>\n        \n        <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch\" data-kid=\"1-1-2\" data-name=\"bento grid container\">\n            \n            <div class=\"lg:col-span-1\" data-kid=\"1-1-2-1\" data-name=\"identity card\" id=\"card-identity\">\n                <div class=\"notch-clip h-full\" data-kid=\"1-1-2-1-1\" data-name=\"identity card outer frame\" style=\"background-color: rgba(51,65,85,0.5); padding:1px;\">\n                    <div class=\"notch-clip h-full flex flex-col\" data-kid=\"1-1-2-1-1-1\" data-name=\"identity card inner container\" style=\"background-color:#0A1628;\">\n                        \n                        <div class=\"relative overflow-hidden shrink-0\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"portrait image container\" style=\"aspect-ratio: 4 / 4.4;\">\n                            <img alt=\"Rehan Shaikh — portrait\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"1-1-2-1-1-1-1-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/My_Pic.jpeg\" style=\"object-position: center 20%; filter: grayscale(0.35) contrast(1.06) brightness(0.92);\">\n                            \n                            <div class=\"absolute inset-0\" data-kid=\"1-1-2-1-1-1-1-2\" data-name=\"duotone overlay layer\" style=\"background: linear-gradient(180deg, rgba(59,130,246,0.16) 0%, rgba(4,13,31,0.15) 45%, rgba(4,13,31,0.85) 100%); mix-blend-mode: normal;\">\n                            </div>\n                            \n                            <div class=\"absolute inset-0 halftone opacity-60\" data-kid=\"1-1-2-1-1-1-1-3\" data-name=\"halftone grid effect layer\">\n                            </div>\n                            \n                            <div class=\"absolute top-4 left-4 font-jbmono text-[10px] tracking-widest text-slate-300/80 bg-[#040D1F]/60 backdrop-blur-sm border border-slate-700/50 rounded-sm px-2 py-1\" data-kid=\"1-1-2-1-1-1-1-4\" data-name=\"location coordinates tag\">\n                                18.5204° N · 73.8567° E\n                            </div>\n                        </div>\n                        \n                        <div class=\"p-8 flex flex-col gap-5 grow\" data-kid=\"1-1-2-1-1-1-2\" data-name=\"identity details container\">\n                            <div data-kid=\"1-1-2-1-1-1-2-1\" data-name=\"name and role container\">\n                                <h3 class=\"text-2xl font-bold text-slate-100 tracking-tight\" data-kid=\"1-1-2-1-1-1-2-1-1\" data-name=\"full name headline\">\n                                    Rehan Shaikh\n                                </h3>\n                                <p class=\"font-jbmono text-[11px] tracking-[0.2em] text-blue-400 mt-1.5 uppercase\" data-kid=\"1-1-2-1-1-1-2-1-2\" data-name=\"job title text\">\n                                    Backend · Java Developer\n                                </p>\n                            </div>\n                            <div class=\"flex items-center gap-2.5 text-sm text-slate-400\" data-kid=\"1-1-2-1-1-1-2-2\" data-name=\"location and status row\">\n                                <span class=\"relative flex h-2 w-2 shrink-0\" data-kid=\"1-1-2-1-1-1-2-2-1\" data-name=\"online status indicator\">\n                                    <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60\" data-kid=\"1-1-2-1-1-1-2-2-1-1\" data-name=\"status ping animation ring\">\n                                    </span>\n                                    <span class=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-400\" data-kid=\"1-1-2-1-1-1-2-2-1-2\" data-name=\"status core dot\">\n                                    </span>\n                                </span>\n                                <span class=\"text-base leading-none\" data-kid=\"1-1-2-1-1-1-2-2-2\" data-name=\"map icon container\">\n                                    <i class=\"ti ti-map-pin text-slate-500\" data-kid=\"1-1-2-1-1-1-2-2-2-1\" data-name=\"map pin icon\">\n                                    </i>\n                                </span>\n                                <span data-kid=\"1-1-2-1-1-1-2-2-3\" data-name=\"location text\">\n                                    BCA Student • Pune, India\n                                </span>\n                            </div>\n                            <div class=\"mt-auto\" data-kid=\"1-1-2-1-1-1-2-3\" data-name=\"graduation info container\">\n                                <span class=\"inline-flex items-center gap-2 font-jbmono text-xs text-pink-400 border border-pink-500/40 rounded-sm px-3 py-2 bg-pink-500/5\" data-kid=\"1-1-2-1-1-1-2-3-1\" data-name=\"graduation tag\">\n                                    <span class=\"text-sm leading-none\" data-kid=\"1-1-2-1-1-1-2-3-1-1\" data-name=\"school icon container\">\n                                        <i class=\"ti ti-school\" data-kid=\"1-1-2-1-1-1-2-3-1-1-1\" data-name=\"school icon\">\n                                        </i>\n                                    </span>\n                                    ETA: JUNE 2027\n                                </span>\n                            </div>\n                            <div class=\"border-t border-slate-700/50 pt-4 font-jbmono text-[10px] text-slate-500 tracking-widest flex justify-between\" data-kid=\"1-1-2-1-1-1-2-4\" data-name=\"footer metadata row\">\n                                <span data-kid=\"1-1-2-1-1-1-2-4-1\" data-name=\"profile ID text\">\n                                    ID: RS-0x2027\n                                </span>\n                                <span class=\"text-emerald-500/80\" data-kid=\"1-1-2-1-1-1-2-4-2\" data-name=\"live online status text\">\n                                    ● ONLINE\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"lg:col-span-2 flex flex-col gap-6\" data-kid=\"1-1-2-2\" data-name=\"main content column\">\n                \n                <div class=\"rounded-xl overflow-hidden border border-slate-700/50 border-t-blue-500/30\" data-kid=\"1-1-2-2-1\" data-name=\"terminal narrative card\" id=\"card-terminal\" style=\"background-color: rgba(10,22,40,0.8); box-shadow: inset 0 1px 24px rgba(4,13,31,0.8), inset 0 1px 0 rgba(59,130,246,0.15);\">\n                    \n                    <div class=\"flex items-center gap-2 px-5 py-3 border-b border-slate-700/50\" data-kid=\"1-1-2-2-1-1\" data-name=\"terminal chrome header\" style=\"background-color:#0A1628;\">\n                        <span class=\"w-3 h-3 rounded-full bg-red-500/80\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"red terminal button\">\n                        </span>\n                        <span class=\"w-3 h-3 rounded-full bg-yellow-500/80\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"yellow terminal button\">\n                        </span>\n                        <span class=\"w-3 h-3 rounded-full bg-emerald-500/80\" data-kid=\"1-1-2-2-1-1-3\" data-name=\"green terminal button\">\n                        </span>\n                        <span class=\"ml-3 font-jbmono text-[11px] text-slate-500 tracking-wider\" data-kid=\"1-1-2-2-1-1-4\" data-name=\"terminal title text\">\n                            rehan@backend: ~/about\n                        </span>\n                    </div>\n                    <div class=\"p-8 lg:p-10 space-y-5\" data-kid=\"1-1-2-2-1-2\" data-name=\"terminal body text container\">\n                        <p class=\"font-jbmono text-sm text-slate-500\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"terminal intro command line\">\n                            <span class=\"text-pink-500\" data-kid=\"1-1-2-2-1-2-1-1\" data-name=\"shell prompt symbol\">\n                                >\n                            </span>\n                            initializing backend architect profile\n                            <span class=\"text-slate-400\" data-kid=\"1-1-2-2-1-2-1-2\" data-name=\"command ellipsis\">\n                                ...\n                            </span>\n                            <span class=\"caret text-emerald-400\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-3\" data-name=\"terminal caret\" data-reason=\"opacity toggled by blinking animation\">\n                                ▊\n                            </span>\n                        </p>\n                        <p class=\"text-lg text-slate-400 leading-relaxed\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"bio paragraph one\">\n                            I'm a backend-focused\n                            <span class=\"bg-blue-500/10 text-blue-400 rounded px-1.5 py-0.5 whitespace-nowrap\" data-kid=\"1-1-2-2-1-2-2-1\" data-name=\"highlighted skill tag one\">\n                                Java\n                            </span>\n                            developer building scalable applications and reliable server-side systems for real-world usage.\n                        </p>\n                        <p class=\"text-lg text-slate-400 leading-relaxed\" data-kid=\"1-1-2-2-1-2-3\" data-name=\"bio paragraph two\">\n                            My core expertise lies in\n                            <span class=\"bg-blue-500/10 text-blue-400 rounded px-1.5 py-0.5 whitespace-nowrap\" data-kid=\"1-1-2-2-1-2-3-1\" data-name=\"highlighted skill tag two\">\n                                Spring Boot\n                            </span>\n                            —\n              designing\n                            <span class=\"bg-blue-500/10 text-blue-400 rounded px-1.5 py-0.5 whitespace-nowrap\" data-kid=\"1-1-2-2-1-2-3-2\" data-name=\"highlighted skill tag three\">\n                                REST APIs\n                            </span>\n                            ,\n              authentication flows and business logic with strong data integrity. I work closely with MySQL and PostgreSQL: schema design, query efficiency and performance tuning.\n                        </p>\n                        <p class=\"text-lg text-slate-400 leading-relaxed\" data-kid=\"1-1-2-2-1-2-4\" data-name=\"bio paragraph three\">\n                            Lately I've been exploring\n                            <span class=\"bg-blue-500/10 text-blue-400 rounded px-1.5 py-0.5 whitespace-nowrap\" data-kid=\"1-1-2-2-1-2-4-1\" data-name=\"highlighted skill tag four\">\n                                Spring AI\n                            </span>\n                            to wire intelligent features into backends — and shipping with AWS, GitHub and Vercel.\n                        </p>\n                    </div>\n                </div>\n                \n                <div class=\"rounded-xl border border-slate-700/50 blueprint-grid grow\" data-kid=\"1-1-2-2-2\" data-name=\"ecosystem stack card\" id=\"card-ecosystem\" style=\"background-color: rgba(10,22,40,0.6);\">\n                    <div class=\"p-8 lg:p-10\" data-kid=\"1-1-2-2-2-1\" data-name=\"ecosystem card content\">\n                        <div class=\"flex items-center justify-between mb-8\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"ecosystem card header\">\n                            <p class=\"font-jbmono text-[11px] tracking-[0.25em] text-slate-500 uppercase\" data-kid=\"1-1-2-2-2-1-1-1\" data-name=\"architecture title text\">\n                                // system architecture\n                            </p>\n                            <p class=\"font-jbmono text-[10px] text-slate-600\" data-kid=\"1-1-2-2-2-1-1-2\" data-name=\"request response status text\">\n                                req → res · 200 OK\n                            </p>\n                        </div>\n                        <div class=\"flex flex-col md:flex-row items-stretch md:items-center gap-4 md:gap-0\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"flow diagram container\">\n                            \n                            <div class=\"flow-node flow-node-pink rounded-lg border border-slate-700/60 px-5 py-4 md:w-52 shrink-0 cursor-default\" data-kid=\"1-1-2-2-2-1-2-1\" data-name=\"cloud node box\" style=\"background-color:#0A1628;\">\n                                <div class=\"flex items-center gap-2 text-pink-400 text-xl mb-2\" data-kid=\"1-1-2-2-2-1-2-1-1\" data-name=\"cloud header\">\n                                    <i class=\"ti ti-cloud\" data-kid=\"1-1-2-2-2-1-2-1-1-1\" data-name=\"cloud icon\">\n                                    </i>\n                                    <span class=\"font-jbmono text-[10px] tracking-[0.25em] text-pink-400/90\" data-kid=\"1-1-2-2-2-1-2-1-1-2\" data-name=\"cloud title\">\n                                        CLOUD\n                                    </span>\n                                </div>\n                                <p class=\"text-sm text-slate-300 font-medium\" data-kid=\"1-1-2-2-2-1-2-1-2\" data-name=\"cloud platform name\">\n                                    AWS\n                                </p>\n                                <p class=\"font-jbmono text-[11px] text-slate-500 mt-0.5\" data-kid=\"1-1-2-2-2-1-2-1-3\" data-name=\"cloud services list\">\n                                    EC2 / S3 / CloudFront\n                                </p>\n                            </div>\n                            \n                            <div class=\"hidden md:flex grow items-center px-1\" data-kid=\"1-1-2-2-2-1-2-2\" data-name=\"horizontal connector\">\n                                <div class=\"flow-dash-h w-full\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-1-2-2-1\" data-name=\"animated dashed horizontal line\" data-reason=\"background position moved by animation\">\n                                </div>\n                                <i class=\"ti ti-chevron-right text-slate-600 -ml-1\" data-kid=\"1-1-2-2-2-1-2-2-2\" data-name=\"chevron icon\">\n                                </i>\n                            </div>\n                            <div class=\"md:hidden flex justify-center\" data-kid=\"1-1-2-2-2-1-2-3\" data-name=\"vertical connector container\">\n                                <div class=\"flow-dash-v h-8\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-1-2-3-1\" data-name=\"animated dashed vertical line\" data-reason=\"background position moved by animation\">\n                                </div>\n                            </div>\n                            \n                            <div class=\"flow-node flow-node-blue rounded-lg border border-blue-500/50 px-6 py-5 md:w-60 shrink-0 cursor-default relative\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-1-2-4\" data-name=\"core node box\" data-reason=\"glow box shadow pulsed by animation\" style=\"background-color:#0A1628; box-shadow: 0 0 28px rgba(59,130,246,0.22), inset 0 1px 0 rgba(59,130,246,0.25);\">\n                                <div class=\"absolute -top-2 left-1/2 -translate-x-1/2 font-jbmono text-[9px] tracking-[0.2em] text-blue-300 bg-[#040D1F] border border-blue-500/40 rounded-sm px-2 py-0.5\" data-kid=\"1-1-2-2-2-1-2-4-1\" data-name=\"core node badge\">\n                                    MAIN\n                                </div>\n                                <div class=\"flex items-center gap-2 text-blue-400 text-xl mb-2\" data-kid=\"1-1-2-2-2-1-2-4-2\" data-name=\"core header\">\n                                    <i class=\"ti ti-server\" data-kid=\"1-1-2-2-2-1-2-4-2-1\" data-name=\"server icon\">\n                                    </i>\n                                    <span class=\"font-jbmono text-[10px] tracking-[0.25em] text-blue-400/90\" data-kid=\"1-1-2-2-2-1-2-4-2-2\" data-name=\"core title\">\n                                        CORE\n                                    </span>\n                                </div>\n                                <p class=\"text-sm text-slate-100 font-semibold\" data-kid=\"1-1-2-2-2-1-2-4-3\" data-name=\"core technology list\">\n                                    Java · Spring Boot\n                                </p>\n                                <p class=\"font-jbmono text-[11px] text-slate-500 mt-0.5\" data-kid=\"1-1-2-2-2-1-2-4-4\" data-name=\"core subtitle\">\n                                    + Spring AI\n                                </p>\n                            </div>\n                            \n                            <div class=\"hidden md:flex grow items-center px-1\" data-kid=\"1-1-2-2-2-1-2-5\" data-name=\"horizontal connector\">\n                                <div class=\"flow-dash-h w-full\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-1-2-5-1\" data-name=\"animated dashed horizontal line\" data-reason=\"background position moved by animation\">\n                                </div>\n                                <i class=\"ti ti-chevron-right text-slate-600 -ml-1\" data-kid=\"1-1-2-2-2-1-2-5-2\" data-name=\"chevron icon\">\n                                </i>\n                            </div>\n                            <div class=\"md:hidden flex justify-center\" data-kid=\"1-1-2-2-2-1-2-6\" data-name=\"vertical connector container\">\n                                <div class=\"flow-dash-v h-8\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-1-2-6-1\" data-name=\"animated dashed vertical line\" data-reason=\"background position moved by animation\">\n                                </div>\n                            </div>\n                            \n                            <div class=\"flow-node flow-node-emerald rounded-lg border border-slate-700/60 px-5 py-4 md:w-52 shrink-0 cursor-default\" data-kid=\"1-1-2-2-2-1-2-7\" data-name=\"data node box\" style=\"background-color:#0A1628;\">\n                                <div class=\"flex items-center gap-2 text-emerald-400 text-xl mb-2\" data-kid=\"1-1-2-2-2-1-2-7-1\" data-name=\"data header\">\n                                    <i class=\"ti ti-database\" data-kid=\"1-1-2-2-2-1-2-7-1-1\" data-name=\"database icon\">\n                                    </i>\n                                    <span class=\"font-jbmono text-[10px] tracking-[0.25em] text-emerald-400/90\" data-kid=\"1-1-2-2-2-1-2-7-1-2\" data-name=\"data title\">\n                                        DATA\n                                    </span>\n                                </div>\n                                <p class=\"text-sm text-slate-300 font-medium\" data-kid=\"1-1-2-2-2-1-2-7-2\" data-name=\"database list\">\n                                    MySQL / PostgreSQL\n                                </p>\n                                <p class=\"font-jbmono text-[11px] text-slate-500 mt-0.5\" data-kid=\"1-1-2-2-2-1-2-7-3\" data-name=\"data description\">\n                                    schema · queries · perf\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"5\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"6\"></script>\n<script data-kid=\"7\">\n    gsap.registerPlugin(ScrollTrigger);\n\n  // header + circuit line draw\n  const path = document.getElementById('circuit-path');\n  const len = path.getTotalLength();\n  gsap.set(path, { strokeDasharray: '6 6', strokeDashoffset: 0 });\n  gsap.from('#about-header', { y: 24, opacity: 0, duration: 0.9, ease: 'power3.out' });\n  gsap.from('#circuit-line', { opacity: 0, x: -30, duration: 1, delay: 0.3, ease: 'power3.out' });\n  gsap.from('#circuit-dot', { scale: 0, transformOrigin: 'center', duration: 0.5, delay: 1, ease: 'back.out(3)' });\n\n  // bento entrances\n  gsap.from('#card-identity', {\n    x: -60, opacity: 0, duration: 1, ease: 'power3.out',\n    scrollTrigger: { trigger: '#card-identity', start: 'top 88%' }\n  });\n  gsap.from('#card-terminal', {\n    x: 60, y: -20, opacity: 0, duration: 1, delay: 0.15, ease: 'power3.out',\n    scrollTrigger: { trigger: '#card-terminal', start: 'top 88%' }\n  });\n  gsap.from('#card-ecosystem', {\n    y: 60, opacity: 0, duration: 1, delay: 0.3, ease: 'power3.out',\n    scrollTrigger: { trigger: '#card-ecosystem', start: 'top 92%' }\n  });\n\n  // flowing dashed connectors (left → right / top → bottom)\n  gsap.to('.flow-dash-h', { backgroundPositionX: '14px', duration: 0.7, ease: 'none', repeat: -1 });\n  gsap.to('.flow-dash-v', { backgroundPositionY: '14px', duration: 0.7, ease: 'none', repeat: -1 });\n\n  // subtle idle pulse on the core node glow\n  gsap.to('.flow-node-blue', {\n    boxShadow: '0 0 40px rgba(59,130,246,0.35), inset 0 1px 0 rgba(59,130,246,0.3)',\n    duration: 1.8, ease: 'sine.inOut', yoyo: true, repeat: -1\n  });\n</script>\n",
